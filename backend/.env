PROJECT_NAME="TechGear Store API"
API_V1_STR="/api/v1"
SECRET_KEY="techgear_super_secret_jwt_key_replace_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Database
DATABASE_URL="sqlite:///./techgear.db"

# Google Gemini API Key
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
